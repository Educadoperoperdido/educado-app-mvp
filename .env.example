# Copia este archivo como .env y llena con los valores de tu proyecto de Supabase
# (Project Settings > API en el dashboard de Supabase)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Variables usadas solo por las Edge Functions (se configuran en Supabase, no aquí)
# SUPABASE_SERVICE_ROLE_KEY=...
# QUIZ_WEBHOOK_SECRET=un-secreto-que-tú-inventes-y-uses-también-en-el-quiz-de-lovable
